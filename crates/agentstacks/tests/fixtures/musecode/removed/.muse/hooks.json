{
  "editor": { "keep": ["user-value"] },
  "hooks": {
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "echo only-ours # agentstacks" } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "echo user", "timeout": 3 } ] },
      { "hooks": [ { "type": "command", "command": "echo gone # agentstacks" } ] }
    ]
  }
}
